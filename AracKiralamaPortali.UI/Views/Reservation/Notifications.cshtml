@{
    ViewData["Title"] = "Bildirimler";
}

<h2><i class="fas fa-bell"></i> Bildirimler (Teslim Onayý Bekleyenler)</h2>

<div class="table-responsive mt-3">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Plaka</th>
                <th>Marka</th>
                <th>Baþlangýç</th>
                <th>Bitiþ</th>
                <th>Bildirim</th>
                <th>Ýþlem</th>
            </tr>
        </thead>
        <tbody id="notificationList"></tbody>
    </table>
    <div id="noNotificationMsg" class="alert alert-info d-none">Teslim onayý bekleyen bildiriminiz bulunmamaktadýr.</div>
</div>

<h4 class="mt-4"><i class="fas fa-star"></i> Araç Sahibi Bildirimleri</h4>
<div id="ownerNotificationCard" class="card mt-3 d-none">
    <div class="list-group list-group-flush" id="ownerNotificationList"></div>
</div>
<div id="noOwnerNotificationMsg" class="alert alert-info d-none mt-3">Mevcut araç sahibi bildiriminiz bulunmamaktadýr.</div>

@section Scripts {
<script>
    $(document).ready(function () {
        if (!isLoggedIn()) { window.location.href = "/Auth/Login"; return; }
        loadNotifications();
        loadOwnerNotifications();
    });

    function loadNotifications() {
        var urlToCall = isAdmin() ? (apiBaseUrl + "/Reservations") : (apiBaseUrl + "/Reservations/owner-reservations");
        $.ajax({
            url: urlToCall,
            type: "GET",
            success: function (data) {
                var html = "";
                var count = 0;
                $.each(data, function (i, r) {
                    if (r.status === "ReturnPending" && !r.isReturnConfirmed) {
                        count++;
                        html += "<tr>";
                        html += "<td>" + r.vehiclePlate + "</td>";
                        html += "<td>" + (r.brandName || "-") + "</td>";
                        html += "<td>" + new Date(r.startDate).toLocaleDateString("tr-TR") + "</td>";
                        html += "<td>" + new Date(r.endDate).toLocaleDateString("tr-TR") + "</td>";
                        html += "<td>Teslim talebi var! Onayýnýz bekleniyor.</td>";
                        html += "<td>";
                        html += '<button class="btn btn-sm btn-success" onclick="confirmReturn(' + r.id + ')"><i class="fas fa-check"></i> Teslim Onayla</button>';
                        html += "</td>";
                        html += "</tr>";
                    }
                });

                if (count > 0) {
                    $("#notificationList").html(html);
                    $("#noNotificationMsg").addClass("d-none");
                    $(".table").removeClass("d-none");
                } else {
                    $("#notificationList").html("");
                    $("#noNotificationMsg").removeClass("d-none");
                    $(".table").addClass("d-none");
                }
            },
            error: function () {
                console.log("Bildirimler yüklenirken hata oluþtu.");
            }
        });
    }

    function confirmReturn(id) {
        appConfirm("Aracýn teslimatýný onaylamak istediðinize emin misiniz?", function() {
            $.ajax({
                url: apiBaseUrl + "/Reservations/" + id + "/confirm-return",
                type: "PUT",
                success: function (res) {
                    appAlert(res.message || "Araç teslimi baþarýyla onaylandý.", "success");
                    loadNotifications();
                    checkReturnNotifications(); // update badge
                },
                error: function (xhr) {
                    var msg = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : "Hata oluþtu.";
                    appAlert(msg, "error");
                }
            });
        });
    }

    function loadOwnerNotifications() {
        $.ajax({
            url: apiBaseUrl + "/Vehicles/owner-notifications",
            type: "GET",
            success: function (data) {
                var filteredData = (data || []).filter(function (n) {
                    return n.type !== "Question" || !n.isAnswered;
                });
                if (filteredData.length === 0) {
                    $("#ownerNotificationList").html("");
                    $("#ownerNotificationCard").addClass("d-none");
                    $("#noOwnerNotificationMsg").removeClass("d-none");
                    return;
                }

                var html = "";
                $.each(filteredData, function (i, n) {
                    var date = new Date(n.createdAt).toLocaleDateString("tr-TR");
                    var isQuestion = n.type === "Question";
                    var icon = isQuestion ? "fa-question-circle text-primary" : "fa-star text-warning";
                    var title = isQuestion ? "Yeni soru" : "Yeni yorum";
                    var message = n.message ? n.message : "-";
                    var ratingText = (!isQuestion && n.rating) ? '<div class="text-warning small">Puan: ' + n.rating + '/5</div>' : "";
                    var answerText = (isQuestion && !n.isAnswered) ? '<div class="text-muted small fst-italic">Cevap bekleniyor.</div>' : "";

                    html += '<a class="list-group-item list-group-item-action" href="/Vehicle/Detail?id=' + n.vehicleId + '">';
                    html += '  <div class="d-flex justify-content-between">';
                    html += '    <div><i class="fas ' + icon + '"></i> ' + title + ' - ' + n.userFullName + '</div>';
                    html += '    <small class="text-muted">' + date + '</small>';
                    html += '  </div>';
                    html += '  <div class="small text-muted">' + n.brandName + ' / ' + n.vehiclePlate + '</div>';
                    html += '  <div class="small">' + message + '</div>';
                    html += ratingText + answerText;
                    html += '</a>';
                });

                $("#ownerNotificationList").html(html);
                $("#ownerNotificationCard").removeClass("d-none");
                $("#noOwnerNotificationMsg").addClass("d-none");
            },
            error: function () {
                console.log("Ara? bildirimleri y?klenirken hata olu?tu.");
            }
        });
    }
</script>
}
